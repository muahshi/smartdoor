<resources>
    <!-- Minimal manifest-level theme; actual Material 3 theming lives in
         Compose (ui/theme/Theme.kt). This just sets the window background
         before Compose content is set. -->
    <style name="Theme.SmartDoor" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Phase 12E.2 — PREMIUM APP IDENTITY, Task 2: official Android 12+
         SplashScreen API. Set as MainActivity's manifest theme; installed
         via androidx.core.splashscreen.SplashScreen.installSplashScreen()
         in MainActivity.onCreate() (must run before super.onCreate()).
         Shows black + the new launcher icon system-side, before Compose
         even inflates, then hands off to Theme.SmartDoor via
         postSplashScreenTheme once the activity draws its first frame —
         at which point Routes.SPLASH's own Premium Compose splash
         (SplashScreen.kt) takes over. -->
    <style name="Theme.SmartDoor.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SmartDoor</item>
    </style>
</resources>
