<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase A1.2: INTERNET is the only permission needed for the network
         client (Supabase/Ktor) to compile and operate. Camera, mic,
         notifications, etc. are added in the phases that actually
         implement those features. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 12E.8 — PREMIUM SMART PLATE ECOSYSTEM. Only needed on API
         26-28 (pre-scoped-storage) for QrImageUtil.saveToGallery's
         MediaStore insert; API 29+ needs no permission for that call.
         QrPreviewScreen requests this at runtime before saving on those
         older API levels. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".SmartDoorApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SmartDoor"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartDoor.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 12E.8 — PREMIUM SMART PLATE ECOSYSTEM. Backs
             QrImageUtil.share's chooser Intent; exposes only the
             shared_qr/ cache subfolder, see res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
