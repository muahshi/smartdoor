<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase A1.2: INTERNET is the only permission needed for the network
         client (Supabase/Ktor) to compile and operate. Camera, mic,
         notifications, etc. are added in the phases that actually
         implement those features. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 12E.8 — PREMIUM SMART PLATE ECOSYSTEM. Only needed on API
         26-28 (pre-scoped-storage) for QrImageUtil.saveToGallery's
         MediaStore insert; API 29+ needs no permission for that call.
         QrPreviewScreen requests this at runtime before saving on those
         older API levels. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Phase 12E.10 — NATIVE QR SCANNER. CAMERA is requested at runtime by
         QrScannerScreen only (rememberLauncherForActivityResult, same
         pattern QrPreviewScreen already uses for WRITE_EXTERNAL_STORAGE) —
         nothing else in the app touches the camera. uses-feature is
         required="false" so the app still installs on camera-less devices;
         QrScannerScreen's own CameraUnavailable state handles that case at
         runtime instead of Play Store filtering the app out. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Phase 12E.13 — NATIVE CALLING EXPERIENCE: Foreground Ringing &
         Notifications. POST_NOTIFICATIONS is the API 33+ runtime
         notification permission (requested by MainActivity); the two
         FOREGROUND_SERVICE permissions back CallRingForegroundService
         (declared with android:foregroundServiceType="phoneCall" below —
         FOREGROUND_SERVICE_PHONE_CALL is required for that type on API
         34+, install-time granted). USE_FULL_SCREEN_INTENT lets the
         incoming-call notification launch IncomingCallActivity over the
         lock screen; VIBRATE backs the ring vibration pattern. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".SmartDoorApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SmartDoor"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartDoor.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 12E.13 — NATIVE CALLING EXPERIENCE: Foreground Ringing &
             Notifications. Full-screen incoming-call UI, launched by
             CallNotificationManager's full-screen intent (over the lock
             screen) or by CallActionReceiver's Accept action. Not
             exported — only this app's own PendingIntents launch it.
             showWhenLocked/turnScreenOn are the API 27+ manifest
             equivalents of the runtime calls IncomingCallActivity also
             makes for API 26 devices (minSdk). -->
        <activity
            android:name=".ui.incomingcall.IncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.SmartDoor" />

        <!-- Phase 12E.13 — keeps the incoming-call notification alive and
             plays the ring/vibration while a call is in
             CallPhase.INCOMING. Type "phoneCall" matches the actual
             foreground work being done (see CallRingForegroundService's
             doc comment). Never bound, only started. -->
        <service
            android:name=".service.CallRingForegroundService"
            android:exported="false"
            android:foregroundServiceType="phoneCall" />

        <!-- Phase 12E.13 — handles the Accept/Reject action buttons on the
             incoming-call notification. Not exported — only this app's
             own PendingIntents broadcast to it. -->
        <receiver
            android:name=".core.call.CallActionReceiver"
            android:exported="false" />

        <!-- Phase 12E.15 — MASKED CALL → NATIVE ANDROID FCM NOTIFICATION.
             Receives FCM data messages (masked-call offers) even when the
             app process was previously killed. Not exported — the OS
             delivers to this via the Firebase Messaging SDK only; nothing
             else should bind to it. Requires app/google-services.json to
             actually initialize FirebaseApp at runtime (see
             app/build.gradle.kts's conditional plugin application) —
             the class itself compiles and installs regardless. -->
        <service
            android:name=".core.notification.SmartDoorFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Phase 12E.8 — PREMIUM SMART PLATE ECOSYSTEM. Backs
             QrImageUtil.share's chooser Intent; exposes only the
             shared_qr/ cache subfolder, see res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
